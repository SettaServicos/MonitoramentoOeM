# Copie para .env localmente ou configure estas variaveis no servico.
# Nao use valores reais neste arquivo versionado.

PVOP_BASE_URL=https://apipv.pvoperation.com.br/api/v1
MONITOR_EMAIL=seu_email@empresa.com
MONITOR_PASSWORD=sua_senha_aqui
TEAMS_WEBHOOK_URL=https://seu-webhook.office.com/...

# Opcional: canais dedicados. Se vazios, os alertas caem no TEAMS_WEBHOOK_URL acima.
# TEAMS_WEBHOOK_URL_RELE=https://webhook-do-canal-reles/...
# TEAMS_WEBHOOK_URL_INVERSOR=https://webhook-do-canal-inversores/...

# Opcional: bundle CA customizado, se exigido pela infraestrutura.
# SSL_CERT_FILE=C:\caminho\para\ca.pem
# REQUESTS_CA_BUNDLE=C:\caminho\para\ca.pem
